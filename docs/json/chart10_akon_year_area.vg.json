
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 790,
  "height": 390,

  "data": {
    "url": "data/akon_year_summary.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "postcard_records": "number",
        "colour_records": "number",
        "non_colour_records": "number",
        "unique_countries": "number",
        "unique_places": "number",
        "colour_percent": "number"
      }
    }
  },

  "params": [
    {
      "name": "series_select",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Colour",
          "Non-colour"
        ],
        "labels": [
          "All exactly dated records",
          "Colour records",
          "Non-colour records"
        ],
        "name": "Record category: "
      }
    }
  ],

  "transform": [
    {
      "calculate": "series_select == 'Colour' ? datum.colour_records : series_select == 'Non-colour' ? datum.non_colour_records : datum.postcard_records",
      "as": "selected_records"
    }
  ],

  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",

      "scale": {
        "domain": [1893, 1925],
        "nice": false
      },

      "axis": {
        "values": [
          1895,
          1900,
          1905,
          1910,
          1915,
          1920,
          1925
        ],
        "format": "d",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "labelPadding": 8,
        "titlePadding": 14,
        "grid": false
      }
    },

    "y": {
      "field": "selected_records",
      "type": "quantitative",
      "title": "Exactly dated AKON records",

      "scale": {
        "domain": [0, 1200],
        "nice": false
      },

      "axis": {
        "values": [0, 200, 400, 600, 800, 1000, 1200],
        "format": ",",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titlePadding": 15,
        "grid": true,
        "gridColor": "#e8e8e8"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#88a9b8",
        "opacity": 0.65,
        "interpolate": "linear",
        "line": {
          "color": "#3f687e",
          "strokeWidth": 2
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "color": "#3f687e",
        "size": 45,
        "opacity": 0.85
      },

      "encoding": {
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Exact year",
            "format": "d"
          },

          {
            "field": "selected_records",
            "type": "quantitative",
            "title": "Records in selected category",
            "format": ","
          },

          {
            "field": "postcard_records",
            "type": "quantitative",
            "title": "All exactly dated records",
            "format": ","
          },

          {
            "field": "colour_records",
            "type": "quantitative",
            "title": "Colour records",
            "format": ","
          },

          {
            "field": "non_colour_records",
            "type": "quantitative",
            "title": "Non-colour records",
            "format": ","
          },

          {
            "field": "colour_percent",
            "type": "quantitative",
            "title": "Colour share of yearly records (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "year": 1914
          }
        ]
      },

      "mark": {
        "type": "rule",
        "color": "#9a6c65",
        "strokeWidth": 1.5,
        "strokeDash": [5, 4]
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "datum": 0
        },
        "y2": {
          "datum": 1100
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "year": 1914,
            "annotation": "World War I begins"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#805650"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },

        "y": {
          "datum": 1120
        },

        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": "#ffffff",

    "view": {
      "stroke": null
    },

    "font": "Source Sans Pro",

    "axis": {
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
