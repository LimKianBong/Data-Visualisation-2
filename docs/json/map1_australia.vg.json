{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Compact, responsive comparison of state-assigned NMA counts and mapped SLNSW records across Australian states.",
  "width": "container",
  "height": 410,
  "padding": {
    "left": 2,
    "right": 2,
    "top": 2,
    "bottom": 2
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "params": [
    {
      "name": "collection_select",
      "value": "NMA",
      "bind": {
        "input": "select",
        "options": [
          "NMA",
          "SLNSW"
        ],
        "labels": [
          "National Museum of Australia",
          "State Library of New South Wales"
        ],
        "name": "Collection: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": {
      "expr": "min(width * 1.23, 710)"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/australia_state_comparison.csv"
      },
      "transform": [
        {
          "lookup": "state_clean",
          "from": {
            "data": {
              "url": "data/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "australia_states"
              }
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        },
        {
          "filter": "datum.source == collection_select"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "share_percent",
          "type": "quantitative",
          "title": "State share (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "scheme": "oranges"
          },
          "legend": {
            "title": "State share (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "gradientThickness": 12,
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "offset": 5,
            "titleFontSize": 13,
            "labelFontSize": 12,
            "titleLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "state_clean",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "source_name",
            "type": "nominal",
            "title": "Collection"
          },
          {
            "field": "postcard_records",
            "type": "quantitative",
            "title": "Geographic record counts",
            "format": ","
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "Share within collection (%)",
            "format": ".1f"
          },
          {
            "field": "measure_note",
            "title": "Counting unit"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_state_comparison.csv"
      },
      "transform": [
        {
          "filter": "datum.source == collection_select"
        },
        {
          "filter": "datum.state_clean == 'New South Wales'"
        },
        {
          "calculate": "'NSW: ' + format(datum.share_percent, '.1f') + '%'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#54331f",
        "dy": -5,
        "align": "center",
        "baseline": "bottom"
      },
      "encoding": {
        "longitude": {
          "datum": 147
        },
        "latitude": {
          "datum": -32
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#39574d",
      "titleColor": "#244441",
      "layout": {
        "bottom": {
          "anchor": "middle",
          "center": true
        },
        "top": {
          "anchor": "middle",
          "center": true
        }
      },
      "labelFontSize": 12,
      "titleFontSize": 13,
      "offset": 7
    },
    "view": {
      "stroke": null
    }
  }
}
