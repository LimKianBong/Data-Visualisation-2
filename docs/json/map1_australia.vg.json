{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "params": [
    {
      "name": "collection_select",
      "value": "NMA",
      "bind": {
        "input": "select",
        "options": [
          "NMA",
          "SLNSW"
        ],
        "labels": [
          "National Museum of Australia",
          "State Library of New South Wales"
        ],
        "name": "Collection: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": {
      "expr": "min(width * 1.32, 650)"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/australia_state_comparison.csv"
      },
      "transform": [
        {
          "lookup": "state_clean",
          "from": {
            "data": {
              "url": "data/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "australia_states"
              }
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        },
        {
          "filter": "datum.source == collection_select"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "share_percent",
          "type": "quantitative",
          "title": "Share of mapped records (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "scheme": "oranges"
          },
          "legend": {
            "title": "Share of mapped records (%)",
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": {
              "expr": "min(360, width - 10)"
            },
            "titleLimit": 400
          }
        },
        "tooltip": [
          {
            "field": "state_clean",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "source_name",
            "type": "nominal",
            "title": "Postcard collection"
          },
          {
            "field": "postcard_records",
            "type": "quantitative",
            "title": "Mapped postcard records",
            "format": ","
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "Share of mapped collection (%)",
            "format": ".1f"
          },
          {
            "field": "measure_note",
            "title": "Counting unit"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_state_comparison.csv"
      },
      "transform": [
        {
          "lookup": "state_clean",
          "from": {
            "data": {
              "url": "data/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "australia_states"
              }
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        },
        {
          "filter": "datum.source == collection_select"
        },
        {
          "filter": "datum.state_clean == 'New South Wales'"
        },
        {
          "calculate": "'NSW: '+format(datum.share_percent,'.1f')+'%'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#54331f",
        "dy": -7
      },
      "encoding": {
        "longitude": {
          "datum": 147
        },
        "latitude": {
          "datum": -32
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "view": {
      "stroke": null
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": [
      "Darker shading means a larger share within the selected collection."
    ],
    "anchor": "start",
    "fontSize": 12,
    "fontWeight": "normal",
    "color": "#39574d",
    "offset": 16
  }
}
