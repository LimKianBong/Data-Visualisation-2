{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 450,

  "params": [
    {
      "name": "minimum_records",
      "value": 1,
      "bind": {
        "input": "select",
        "options": [1, 3, 5, 10],
        "labels": [
          "All mapped localities",
          "3 or more records",
          "5 or more records",
          "10 or more records"
        ],
        "name": "Show: "
      }
    }
  ],

  "projection": {
    "type": "equirectangular",
    "center": [147, -32.7],
    "scale": 2550
  },

  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },

      "transform": [
        {
          "filter": "datum.properties.STATE_NAME == 'New South Wales'"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#777777",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "data/slnsw_nsw_localities.csv"
      },

      "transform": [
        {
          "filter": "datum.catalogue_records >= minimum_records"
        }
      ],

      "mark": {
        "type": "circle",
        "color": "#2f6f73",
        "opacity": 0.6,
        "stroke": "white",
        "strokeWidth": 0.7
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "catalogue_records",
          "type": "quantitative",
          "title": "Catalogue records",

          "scale": {
            "domain": [0, 65],
            "range": [15, 1400]
          },

          "legend": {
            "title": "Catalogue records",
            "values": [1, 10, 25, 50],
            "orient": "right"
          }
        },

        "tooltip": [
          {
            "field": "map_place_name",
            "type": "nominal",
            "title": "Locality"
          },

          {
            "field": "catalogue_records",
            "type": "quantitative",
            "title": "Catalogue records",
            "format": ","
          },

          {
            "field": "share_of_nsw_percent",
            "type": "quantitative",
            "title": "Share of mapped NSW records (%)",
            "format": ".1f"
          },

          {
            "field": "individual_records",
            "type": "quantitative",
            "title": "Individual records",
            "format": ","
          },

          {
            "field": "multi_item_records",
            "type": "quantitative",
            "title": "Multi-item or grouped records",
            "format": ","
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/slnsw_nsw_localities.csv"
      },

      "transform": [
        {
          "filter": "datum.catalogue_records >= minimum_records"
        },

        {
          "filter": "datum.locality_rank <= 4"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "dy": -7,
        "fontSize": 10,
        "fontWeight": 600,
        "color": "#333333"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "map_place_name",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}