{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "SLNSW mapped NSW localities shown as proportional symbols. A slider filters small localities to reduce overlap.",
  "width": "container",
  "height": 400,
  "padding": {
    "left": 2,
    "right": 2,
    "top": 2,
    "bottom": 2
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "params": [
    {
      "name": "minimum_records",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 10,
        "step": 1,
        "name": "Minimum records: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -147,
      0,
      0
    ],
    "center": [
      0,
      -32.4
    ],
    "parallels": [
      -30,
      -36
    ],
    "scale": {
      "expr": "min(width * 3.45, 2140)"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_NAME == 'New South Wales'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#8b8b8b",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/slnsw_nsw_localities.csv"
      },
      "transform": [
        {
          "filter": "datum.catalogue_records >= minimum_records"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#2f6f73",
        "opacity": 0.58,
        "stroke": "white",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "catalogue_records",
          "type": "quantitative",
          "title": "Catalogue records",
          "scale": {
            "domain": [
              1,
              65
            ],
            "range": [
              18,
              1300
            ],
            "type": "linear"
          },
          "legend": {
            "title": "Catalogue records",
            "values": [
              1,
              10,
              25,
              50
            ],
            "orient": "bottom",
            "direction": "horizontal",
            "offset": 6,
            "titleLimit": 220,
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolFillColor": "#2f6f73",
            "symbolStrokeColor": "#ffffff"
          }
        },
        "tooltip": [
          {
            "field": "map_place_name",
            "type": "nominal",
            "title": "Locality"
          },
          {
            "field": "catalogue_records",
            "type": "quantitative",
            "title": "Catalogue records",
            "format": ","
          },
          {
            "field": "share_of_nsw_percent",
            "type": "quantitative",
            "title": "Share of mapped NSW records (%)",
            "format": ".1f"
          },
          {
            "field": "individual_records",
            "type": "quantitative",
            "title": "Individual records",
            "format": ","
          },
          {
            "field": "multi_item_records",
            "type": "quantitative",
            "title": "Grouped or multi-item records",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/slnsw_nsw_localities.csv"
      },
      "transform": [
        {
          "filter": "datum.catalogue_records >= minimum_records"
        },
        {
          "filter": "datum.locality_rank <= 3"
        },
        {
          "calculate": "datum.map_place_name + ' · ' + datum.catalogue_records",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "dy": -10,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#333333"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "title": {
    "text": "Larger circles represent more records; filter to reduce overlap.",
    "anchor": "middle",
    "fontSize": 13,
    "fontWeight": "normal",
    "color": "#39574d",
    "offset": 8
  },
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#39574d",
      "titleColor": "#244441",
      "layout": {
        "bottom": {
          "anchor": "middle",
          "center": true
        },
        "top": {
          "anchor": "middle",
          "center": true
        }
      },
      "offset": 7
    },
    "view": {
      "stroke": null
    }
  }
}
