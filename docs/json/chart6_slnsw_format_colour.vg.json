
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 550,

  "data": {
    "url": "data/slnsw_format_colour.csv",
    "format": {
      "type": "csv",
      "parse": {
        "catalogue_records": "number",
        "within_format_percent": "number"
      }
    }
  },

  "params": [
    {
      "name": "minimum_format_records",
      "value": 1,
      "bind": {
        "input": "select",
        "options": [1, 20, 50, 100],
        "labels": [
          "All catalogue formats",
          "20 or more records",
          "50 or more records",
          "100 or more records"
        ],
        "name": "Show formats: "
      }
    }
  ],

  "transform": [
    {
      "impute": "catalogue_records",
      "key": "colour_category",
      "groupby": ["format_group"],
      "keyvals": [
        "Black and white",
        "Sepia",
        "Colour",
        "Mixed",
        "Unknown"
      ],
      "method": "value",
      "value": 0
    },

    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "catalogue_records",
          "as": "format_total"
        }
      ],
      "groupby": ["format_group"]
    },

    {
      "calculate": "datum.catalogue_records / datum.format_total * 100",
      "as": "within_format_pct"
    },

    {
      "filter": "datum.format_total >= minimum_format_records"
    }
  ],

  "encoding": {
    "x": {
      "field": "colour_category",
      "type": "nominal",
      "title": "Recorded visual style",

      "sort": [
        "Black and white",
        "Sepia",
        "Colour",
        "Mixed",
        "Unknown"
      ],

      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelLimit": 160,
        "titleFontSize": 13,
        "titlePadding": 14,
        "labelPadding": 8,
        "grid": false
      }
    },

    "y": {
      "field": "format_group",
      "type": "nominal",
      "title": "Catalogue format",

      "sort": {
        "field": "format_total",
        "op": "max",
        "order": "descending"
      },

      "axis": {
        "labelFontSize": 12,
        "labelLimit": 190,
        "labelPadding": 7,
        "titleFontSize": 13,
        "titlePadding": 14,
        "grid": false
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },

      "encoding": {
        "color": {
          "field": "within_format_pct",
          "type": "quantitative",

          "title": "Share within catalogue format (%)",

          "scale": {
            "domain": [0, 100],
            "range": [
              "#f7f5fa",
              "#c4adda",
              "#583475"
            ]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 330,
            "titleFontSize": 13,
            "labelFontSize": 12,
            "values": [0, 25, 50, 75, 100],
            "labelExpr": "datum.value + '%'"
          }
        },

        "tooltip": [
          {
            "field": "format_group",
            "type": "nominal",
            "title": "Catalogue format"
          },

          {
            "field": "colour_category",
            "type": "nominal",
            "title": "Recorded visual style"
          },

          {
            "field": "catalogue_records",
            "type": "quantitative",
            "title": "Records with this visual style",
            "format": ","
          },

          {
            "field": "format_total",
            "type": "quantitative",
            "title": "Total records in format",
            "format": ","
          },

          {
            "field": "within_format_pct",
            "type": "quantitative",
            "title": "Share within format (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.within_format_pct >= 35 && datum.catalogue_records >= 20"
        },
        {
          "calculate": "format(datum.within_format_pct, '.0f') + '%'",
          "as": "percentage_label"
        }
      ],

      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "center"
      },

      "encoding": {
        "text": {
          "field": "percentage_label",
          "type": "nominal"
        },

        "color": {
          "condition": {
            "test": "datum.within_format_pct >= 55",
            "value": "#ffffff"
          },
          "value": "#30283a"
        }
      }
    }
  ],

  "config": {
    "background": "#ffffff",

    "view": {
      "stroke": null
    },

    "font": "Source Sans Pro",

    "axis": {
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    },

    "legend": {
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
