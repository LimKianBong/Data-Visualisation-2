{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "params": [
    {
      "name": "map_view",
      "value": "World",
      "bind": {
        "input": "select",
        "options": [
          "World",
          "Australia",
          "Europe"
        ],
        "labels": [
          "World overview",
          "Focus on Australia",
          "Focus on Europe"
        ],
        "name": "Map view: "
      }
    },
    {
      "name": "archive_filter",
      "value": "Both",
      "bind": {
        "input": "select",
        "options": [
          "Both",
          "SLNSW",
          "AKON"
        ],
        "labels": [
          "Both archives",
          "SLNSW (Australia)",
          "AKON (international)"
        ],
        "name": "Archive: "
      }
    }
  ],
  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "map_view == 'Australia' ? [134,-25] : map_view == 'Europe' ? [14,49] : [0,0]"
    },
    "scale": {
      "expr": "map_view == 'Australia' ? min(width * 1.7, 700) : map_view == 'Europe' ? min(width * 1.2, 520) : min(width / 5.5, 145)"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#edf4f3",
        "clip": true
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#c6d3cf",
        "strokeWidth": 0.6,
        "fill": null,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e7e2",
        "stroke": "white",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/combined_mapped_places.csv"
      },
      "transform": [
        {
          "filter": "archive_filter == 'Both' || datum.source == archive_filter"
        },
        {
          "calculate": "datum.source == 'SLNSW' ? 1 : 0",
          "as": "draw_priority"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 46,
        "opacity": 0.72,
        "stroke": "#263531",
        "strokeWidth": 0.42,
        "clip": true,
        "filled": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "scale": {
            "domain": [
              "SLNSW",
              "AKON"
            ],
            "range": [
              "#E9BD28",
              "#147D96"
            ]
          },
          "legend": {
            "title": "Collection",
            "orient": "bottom",
            "direction": "horizontal",
            "offset": 6,
            "symbolSize": 155,
            "labelFontSize": 13,
            "titleFontSize": 13,
            "symbolStrokeColor": "#263531",
            "symbolStrokeWidth": 1
          }
        },
        "tooltip": [
          {
            "field": "place",
            "title": "Mapped place"
          },
          {
            "field": "source",
            "title": "Archive"
          },
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "records",
            "title": "Place-record count",
            "format": ","
          }
        ],
        "order": {
          "field": "draw_priority",
          "type": "quantitative",
          "sort": "ascending"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans"
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#39574d",
      "titleColor": "#244441",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "offset": 7,
      "layout": {
        "bottom": {
          "anchor": "middle",
          "center": true
        },
        "top": {
          "anchor": "middle",
          "center": true
        }
      }
    },
    "font": "DM Sans"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": "Each symbol represents a place, not a postcard count.",
    "anchor": "middle",
    "fontSize": 13,
    "fontWeight": "normal",
    "color": "#39574d",
    "offset": 8
  }
}
