{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "params": [
    {
      "name": "minimum_records",
      "value": 1
    },
    {
      "name": "zoom_level",
      "value": 1550,
      "bind": {
        "input": "range",
        "min": 500,
        "max": 6000,
        "step": 50,
        "name": "Zoom (Australia to NSW): "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[133.5 + 16.5 * clamp((zoom_level - 500) / 900, 0, 1), -25.8 - 7.5 * clamp((zoom_level - 500) / 900, 0, 1)]"
    },
    "scale": {
      "expr": "zoom_level"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/nsw_lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#aea99f",
        "strokeOpacity": 0.62,
        "strokeWidth": 0.34
      }
    },
    {
      "data": {
        "url": "data/slnsw_hexbin_50km.topojson",
        "format": {
          "type": "topojson",
          "feature": "slnsw_hexbin_50km"
        }
      },
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "properties.catalogue_records",
              "as": "max_hex_records"
            }
          ]
        },
        {
          "calculate": "datum.max_hex_records > 0 ? datum.properties.catalogue_records / datum.max_hex_records : 0",
          "as": "relative_intensity"
        },
        {
          "filter": "datum.properties.catalogue_records >= minimum_records"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.7,
        "opacity": 0.95
      },
      "encoding": {
        "color": {
          "field": "relative_intensity",
          "type": "quantitative",
          "title": "Relative intensity (busiest cell = 100%)",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              1
            ],
            "scheme": "blues",
            "nice": false,
            "zero": true
          },
          "legend": {
            "orient": "bottom",
            "title": "Relative intensity (%)",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "format": ".0%",
            "gradientLength": {
              "expr": "min(380, width - 20)"
            },
            "titleFontSize": 13,
            "labelFontSize": 12,
            "direction": "horizontal",
            "titleLimit": 430,
            "offset": 7,
            "gradientThickness": 14
          }
        },
        "tooltip": [
          {
            "field": "relative_intensity",
            "type": "quantitative",
            "title": "Relative intensity (max = 100%)",
            "format": ".1%"
          },
          {
            "field": "properties.catalogue_records",
            "type": "quantitative",
            "title": "Records in 50-km hexagon",
            "format": ","
          },
          {
            "field": "max_hex_records",
            "type": "quantitative",
            "title": "Busiest hexagon count",
            "format": ","
          },
          {
            "field": "properties.unique_localities",
            "type": "quantitative",
            "title": "Distinct mapped localities",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#7b7772",
        "strokeWidth": 0.7
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#39574d",
      "titleColor": "#244441",
      "offset": 7,
      "layout": {
        "bottom": {
          "anchor": "middle",
          "center": true
        },
        "top": {
          "anchor": "middle",
          "center": true
        }
      }
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": "Darker blue indicates more records relative to the busiest 50-km hexagon.",
    "anchor": "middle",
    "color": "#39574d",
    "fontSize": 12,
    "fontWeight": "normal",
    "offset": 7
  }
}
