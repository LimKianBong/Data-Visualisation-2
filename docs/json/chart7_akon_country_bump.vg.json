{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 460,
  "data": {
    "url": "data/akon_country_decade_rank.csv",
    "format": {
      "type": "csv",
      "parse": {
        "decade": "number",
        "rank": "number",
        "postcard_records": "number",
        "decade_total_records": "number",
        "decade_share_percent": "number"
      }
    }
  },
  "params": [
    {
      "name": "focus_country",
      "value": "ALL",
      "bind": {
        "input": "select",
        "options": [
          "ALL",
          "AT",
          "DE",
          "IT",
          "CZ",
          "HR",
          "HU",
          "PL",
          "SI"
        ],
        "labels": [
          "All countries",
          "Austria",
          "Germany",
          "Italy",
          "Czechia",
          "Croatia",
          "Hungary",
          "Poland",
          "Slovenia"
        ],
        "name": "Highlight country: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "format(datum.decade_share_percent, '.1f') + '%'",
      "as": "decade_share_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "decade_label",
      "type": "ordinal",
      "sort": [
        "1890s",
        "1900s",
        "1910s",
        "1920s"
      ],
      "title": "Decade",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelPadding": 10,
        "titleFontSize": 13,
        "titlePadding": 15,
        "grid": false
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Country rank (1 = highest)",
      "scale": {
        "domain": [
          1,
          9
        ],
        "reverse": true,
        "nice": false
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9
        ],
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titlePadding": 15,
        "grid": true,
        "gridColor": "#e6e6e6",
        "gridDash": [
          3,
          3
        ]
      }
    },
    "color": {
      "field": "country_name",
      "type": "nominal",
      "title": "Country",
      "scale": {
        "domain": [
          "Austria",
          "Germany",
          "Italy",
          "Czechia",
          "Croatia",
          "Hungary",
          "Poland",
          "Slovenia"
        ],
        "range": [
          "#70418a",
          "#347fa1",
          "#c77839",
          "#438b70",
          "#b15170",
          "#928044",
          "#6176ac",
          "#9a765d"
        ]
      },
      "legend": {
        "orient": "right",
        "title": "Country",
        "titleFontSize": 13,
        "labelFontSize": 12,
        "symbolStrokeWidth": 3
      }
    },
    "detail": {
      "field": "country_name",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "country_name",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "decade_label",
        "type": "nominal",
        "title": "Decade"
      },
      {
        "field": "period_note",
        "type": "nominal",
        "title": "Years covered"
      },
      {
        "field": "rank",
        "type": "quantitative",
        "title": "Rank among AKON countries",
        "format": ".0f"
      },
      {
        "field": "postcard_records",
        "type": "quantitative",
        "title": "Exactly dated postcard records",
        "format": ","
      },
      {
        "field": "decade_total_records",
        "type": "quantitative",
        "title": "All exactly dated records in decade",
        "format": ","
      },
      {
        "field": "decade_share_label",
        "type": "nominal",
        "title": "Share of decade's records"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "linear",
        "strokeCap": "round"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "test": "focus_country == 'ALL' || datum.country_code == focus_country",
            "value": 0.95
          },
          "value": 0.12
        },
        "strokeWidth": {
          "condition": {
            "test": "focus_country == 'ALL' || datum.country_code == focus_country",
            "value": 3
          },
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "size": {
          "value": 95
        },
        "opacity": {
          "condition": {
            "test": "focus_country == 'ALL' || datum.country_code == focus_country",
            "value": 1
          },
          "value": 0.15
        }
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
