{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 820,
  "height": 500,

  "params": [
    {
      "name": "map_extent",
      "value": "World",
      "bind": {
        "input": "select",
        "options": [
          "World",
          "Europe"
        ],
        "labels": [
          "Whole world",
          "Focus on Europe"
        ],
        "name": "Map view: "
      }
    },
    {
      "name": "country_select",
      "value": "ALL",
      "bind": {
        "input": "select",
        "options": [
          "ALL",
          "AT",
          "DE",
          "IT",
          "CZ",
          "CH",
          "HR",
          "FR"
        ],
        "labels": [
          "All countries",
          "Austria",
          "Germany",
          "Italy",
          "Czechia",
          "Switzerland",
          "Croatia",
          "France"
        ],
        "name": "Country: "
      }
    }
  ],

  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "map_extent == 'Europe' ? [14, 49] : [0, 0]"
    },
    "scale": {
      "expr": "map_extent == 'Europe' ? 600 : 160"
    }
  },

  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eaf3f5"
      }
    },

    {
      "data": {
        "graticule": {
          "step": [30, 30]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#b8cbd2",
        "strokeWidth": 0.6
      }
    },

    {
      "data": {
        "url": "data/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece8e0",
        "stroke": "#ffffff",
        "strokeWidth": 0.6
      }
    },

    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "properties": {},
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [0, -80],
                [0, 80]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#758c97",
        "strokeWidth": 1.2,
        "strokeDash": [6, 4]
      }
    },

    {
      "data": {
        "url": "data/akon_places.csv"
      },

      "transform": [
        {
          "filter": "country_select == 'ALL' || datum.country == country_select"
        }
      ],

      "mark": {
        "type": "circle",
        "color": "#873c59",
        "size": 25,
        "opacity": 0.5
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "place",
            "type": "nominal",
            "title": "Mapped place"
          },
          {
            "field": "country",
            "type": "nominal",
            "title": "Country (ISO code)"
          },
          {
            "field": "postcard_records",
            "type": "quantitative",
            "title": "AKON catalogue records",
            "format": ","
          },
          {
            "field": "exact_year_range",
            "type": "nominal",
            "title": "Exact-date year range"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "background": "white",
    "font": "Source Sans Pro"
  }
}