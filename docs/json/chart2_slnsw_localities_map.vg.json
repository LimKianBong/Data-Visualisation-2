{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "NSW proportional-circle map. Select SLNSW (244 mapped NSW localities) or NMA (98 name-matched NSW localities positioned using SLNSW coordinates). The record-count definitions differ between archives.",
  "width": "container",
  "height": 265,
  "padding": {
    "left": 2,
    "right": 2,
    "top": 2,
    "bottom": 30
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "params": [
    {
      "name": "selected_archive",
      "value": "SLNSW",
      "bind": {
        "input": "select",
        "options": [
          "SLNSW",
          "NMA"
        ],
        "labels": [
          "SLNSW",
          "NMA"
        ],
        "name": "Archive: "
      }
    },
    {
      "name": "map_focus",
      "value": "NSW",
      "bind": {
        "input": "select",
        "options": [
          "NSW",
          "Sydney"
        ],
        "labels": [
          "NSW overview",
          "Sydney area"
        ],
        "name": "Map view: "
      }
    },
    {
      "name": "zoom_factor",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 3,
        "step": 0.25,
        "name": "Zoom: "
      }
    },
    {
      "name": "minimum_records",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 10,
        "step": 1,
        "name": "Minimum records: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -147,
      0,
      0
    ],
    "center": {
      "expr": "map_focus == 'Sydney' ? [4.209,-33.86] : [0,-32.4]"
    },
    "parallels": [
      -30,
      -36
    ],
    "scale": {
      "expr": "(map_focus == 'Sydney' ? 20000 : min(width * 4.6, height * 7.2, 2500)) * zoom_factor"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_NAME == 'New South Wales'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#8b8b8b",
        "strokeWidth": 0.8,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/nsw_lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#aea99f",
        "strokeOpacity": 0.6,
        "strokeWidth": 0.33,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/slnsw_nsw_localities.csv",
        "format": {
          "type": "csv",
          "parse": {
            "catalogue_records": "number",
            "share_of_nsw_percent": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "map_place_name",
          "from": {
            "data": {
              "url": "data/nma_slnsw_shared_places.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "nma_count": "number",
                  "nma_pct": "number"
                }
              }
            },
            "key": "place",
            "fields": [
              "nma_count",
              "nma_pct"
            ]
          }
        },
        {
          "calculate": "selected_archive == 'NMA' ? datum.nma_count : datum.catalogue_records",
          "as": "selected_records"
        },
        {
          "calculate": "selected_archive == 'NMA' ? datum.nma_pct : datum.share_of_nsw_percent",
          "as": "selected_share"
        },
        {
          "calculate": "selected_archive == 'NMA' ? 'NMA' : 'SLNSW'",
          "as": "collection"
        },
        {
          "filter": "selected_archive == 'SLNSW' || isValid(datum.nma_count)"
        },
        {
          "filter": "datum.selected_records >= minimum_records"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.84,
        "stroke": "#263531",
        "strokeWidth": 0.7,
        "filled": true,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "selected_records",
          "type": "quantitative",
          "title": "Records at locality",
          "scale": {
            "domain": [
              1,
              150
            ],
            "range": [
              15,
              1050
            ],
            "type": "linear",
            "nice": false,
            "zero": false
          },
          "legend": null
        },
        "color": {
          "field": "collection",
          "type": "nominal",
          "scale": {
            "domain": [
              "NMA",
              "SLNSW"
            ],
            "range": [
              "#592B91",
              "#E9BD28"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "map_place_name",
            "type": "nominal",
            "title": "Locality"
          },
          {
            "field": "collection",
            "type": "nominal",
            "title": "Archive"
          },
          {
            "field": "selected_records",
            "type": "quantitative",
            "title": "Recorded place count",
            "format": ","
          },
          {
            "field": "selected_share",
            "type": "quantitative",
            "title": "Share of that archive’s NSW records (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/slnsw_nsw_localities.csv"
      },
      "transform": [
        {
          "lookup": "map_place_name",
          "from": {
            "data": {
              "url": "data/nma_slnsw_shared_places.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "nma_count": "number",
                  "nma_pct": "number"
                }
              }
            },
            "key": "place",
            "fields": [
              "nma_count",
              "nma_pct"
            ]
          }
        },
        {
          "calculate": "selected_archive == 'NMA' ? datum.nma_count : datum.catalogue_records",
          "as": "selected_records"
        },
        {
          "calculate": "selected_archive == 'NMA' ? datum.nma_pct : datum.share_of_nsw_percent",
          "as": "selected_share"
        },
        {
          "calculate": "selected_archive == 'NMA' ? 'NMA' : 'SLNSW'",
          "as": "collection"
        },
        {
          "filter": "selected_archive == 'SLNSW' || isValid(datum.nma_count)"
        },
        {
          "filter": "datum.selected_records >= minimum_records"
        },
        {
          "filter": "datum.map_place_name == 'Sydney'"
        },
        {
          "calculate": "datum.map_place_name + ' · ' + format(datum.selected_records, ',')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -6,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#333333",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 13,
      "labelColor": "#39574d",
      "titleColor": "#244441",
      "layout": {
        "bottom": {
          "anchor": "middle",
          "center": true
        },
        "top": {
          "anchor": "middle",
          "center": true
        }
      },
      "offset": 7
    },
    "view": {
      "stroke": null
    }
  }
}
