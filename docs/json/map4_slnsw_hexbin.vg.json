{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 690,
  "height": 500,
  "params": [
    {
      "name": "minimum_records",
      "value": 1,
      "bind": {
        "input": "select",
        "options": [
          1,
          3,
          5,
          10,
          25
        ],
        "labels": [
          "All occupied hexagons",
          "At least 3 records",
          "At least 5 records",
          "At least 10 records",
          "At least 25 records"
        ],
        "name": "Display: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [
      134,
      -28
    ],
    "scale": 800
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/slnsw_hexbin_50km.topojson",
        "format": {
          "type": "topojson",
          "feature": "slnsw_hexbin_50km"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.catalogue_records >= minimum_records"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.7,
        "opacity": 0.95
      },
      "encoding": {
        "color": {
          "field": "properties.catalogue_records",
          "type": "quantitative",
          "title": "Catalogue records per hexagon",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              150
            ],
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom",
            "title": "Catalogue records per 50-km cell",
            "values": [
              0,
              10,
              25,
              50,
              100,
              150
            ],
            "gradientLength": 360,
            "titleFontSize": 12,
            "labelFontSize": 11,
            "direction": "horizontal",
            "titleLimit": 400
          }
        },
        "tooltip": [
          {
            "field": "properties.catalogue_records",
            "type": "quantitative",
            "title": "Catalogue records in hexagon",
            "format": ","
          },
          {
            "field": "properties.unique_localities",
            "type": "quantitative",
            "title": "Distinct mapped localities",
            "format": ","
          },
          {
            "field": "properties.share_percent",
            "type": "quantitative",
            "title": "Share of mapped collection (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#7b7772",
        "strokeWidth": 0.7
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
