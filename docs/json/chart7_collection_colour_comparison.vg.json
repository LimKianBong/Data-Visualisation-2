{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 447,
  "data": {
    "url": "data/collection_colour_comparison.csv",
    "format": {
      "type": "csv",
      "parse": {
        "catalogue_records": "number",
        "share_percent": "number",
        "style_order": "number",
        "source_order": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "catalogue_records",
          "as": "collection_total"
        }
      ],
      "groupby": [
        "source"
      ]
    },
    {
      "calculate": "datum.collection_total == 0 ? 0 : datum.catalogue_records / datum.collection_total",
      "as": "fraction"
    },
    {
      "calculate": "format(datum.fraction * 100, '.1f') + '%'",
      "as": "percent_label"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "fraction",
          "as": "end_fraction"
        }
      ],
      "groupby": [
        "source"
      ],
      "sort": [
        {
          "field": "style_order",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.end_fraction - datum.fraction",
      "as": "start_fraction"
    },
    {
      "calculate": "datum.start_fraction + datum.fraction / 2",
      "as": "middle_fraction"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 90,
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      },
      "encoding": {
        "x": {
          "field": "source",
          "type": "nominal",
          "sort": [
            "NMA",
            "SLNSW",
            "AKON"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelPadding": 9,
            "labelAngle": 0,
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "end_fraction",
          "type": "quantitative",
          "title": "Share of each collection",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "format": ".0%",
            "grid": true,
            "gridColor": "#e4e9e6",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 8
          }
        },
        "y2": {
          "field": "start_fraction"
        },
        "color": {
          "field": "style_group",
          "type": "nominal",
          "title": "Recorded visual style",
          "scale": {
            "domain": [
              "Colour",
              "Monochrome / toned",
              "Mixed",
              "Unknown"
            ],
            "range": [
              "#bd7847",
              "#657f91",
              "#689481",
              "#c6b6a2"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "symbolType": "square",
            "symbolSize": 120,
            "labelFontSize": 12,
            "titleFontSize": 12,
            "offset": 7,
            "labelLimit": 185
          }
        },
        "opacity": {
          "condition": {
            "param": "style_highlight",
            "value": 1
          },
          "value": 0.25
        },
        "tooltip": [
          {
            "field": "source_name",
            "type": "nominal",
            "title": "Postcard collection"
          },
          {
            "field": "style_group",
            "type": "nominal",
            "title": "Recorded visual style"
          },
          {
            "field": "catalogue_records",
            "type": "quantitative",
            "title": "Records",
            "format": ","
          },
          {
            "field": "percent_label",
            "type": "nominal",
            "title": "Share"
          }
        ]
      },
      "params": [
        {
          "name": "style_highlight",
          "select": {
            "type": "point",
            "fields": [
              "style_group"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.fraction >= 0.095"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "clip": true
      },
      "encoding": {
        "x": {
          "field": "source",
          "type": "nominal",
          "sort": [
            "NMA",
            "SLNSW",
            "AKON"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelPadding": 9,
            "labelAngle": 0,
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "middle_fraction",
          "type": "quantitative",
          "title": "Share of each collection",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "format": ".0%",
            "grid": true,
            "gridColor": "#e4e9e6",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 8
          }
        },
        "text": {
          "field": "percent_label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "style_highlight",
            "value": 1
          },
          "value": 0.25
        },
        "color": {
          "condition": {
            "test": "datum.style_group == 'Unknown'",
            "value": "#263b39"
          },
          "value": "#ffffff"
        }
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#39574d",
      "titleColor": "#244441",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": "Each bar totals 100%; hover for exact percentages.",
    "anchor": "middle",
    "fontSize": 12,
    "fontWeight": "normal",
    "color": "#39574d",
    "offset": 7
  }
}
